# Copy to .env and fill in. Never commit .env.

# --- Required for curated catalogs -------------------------------------------
# OpenRouter (or any OpenAI-compatible) API key and base URL
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=google/gemini-3.5-flash-lite   # a catalog definition's `model` overrides it

# TMDB credential: the v4 "API Read Access Token" (long, starts with eyJ) or the v3
# 32-character "API Key"; both work. Keep it here only, never in catalog files or commits.
TMDB_API_KEY=

# --- Optional -------------------------------------------------------------------
# MDBList API key (mdblist.com/preferences, API section), only for catalogs with
# `exclude_watched: true`: films you have watched (synced to MDBList) are never listed.
# MDBLIST_API_KEY=

# Externally reachable base URL of this server, no trailing slash
# PUBLIC_BASE_URL=https://catalogs.example.org

# Secret path segment of the addon URLs: <base>/c/<token>/manifest.json. At least 16
# characters of A-Z a-z 0-9 _ -. Unset, the segment is "public". It ends up in AIOMetadata's
# stored config, so treat it as a read-only credential for your movie lists.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ADDON_ACCESS_TOKEN=

# SQLite database. The default is on the compose "data" volume; keep it on a local disk.
# DATABASE_PATH=/data/ai-catalogs.sqlite
# User and group the services run as (like linuxserver images). On start the container makes
# /data theirs, so a bind-mounted data folder needs no chown. Run `id` to see yours.
# PUID=1000
# PGID=1000
# CURATED_ADDON_ID=community.curated-catalogs
# CURATED_ADDON_NAME=AI Catalogs

# --- Operations ---------------------------------------------------------------
# Bearer token for POST /ops/catalogs/<id>/refresh, /dry-run and GET /ops/status, sent as
# "Authorization: Bearer <token>" (never in a URL). Unset, every /ops path answers 404.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# OPS_TOKEN=

# --- Browser editor (/configure) ------------------------------------------------
# Off by default. "/" redirects to it. Two ways to sign in:
#   EDITOR_AUTH=password (default): its own login. Both secrets below are required (the web
#     service refuses to start without them). SESSION_SECRET signs the login cookie (>= 32
#     bytes; changing it logs everyone out); ADMIN_PASSWORD is the password (>= 12 characters).
#     Generate them with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#     Behind a reverse proxy, set FORWARDED_ALLOW_IPS to the proxy's address so the login rate
#     limit counts real clients, and preferably restrict /configure at the proxy.
#   EDITOR_AUTH=proxy: the reverse proxy's login (e.g. Authelia via Traefik forward-auth) and the
#     user name it puts in EDITOR_PROXY_USER_HEADER. Requests without it are refused. The proxy
#     must protect /configure and everything under it; publish no port. Whatever else reaches
#     the container directly (e.g. other containers on its Docker network) could send the header
#     itself. No password needed; SESSION_SECRET optional.
# Set PUBLIC_BASE_URL if the proxy rewrites the Host header (forms check the Origin).
# ENABLE_EDITOR=false
# EDITOR_AUTH=password
# EDITOR_PROXY_USER_HEADER=Remote-User
# SESSION_SECRET=
# ADMIN_PASSWORD=
# Automatic backups (nightly and before each migration; 7 of each kind are kept)
# BACKUP_DIR=/data/backups

# --- Server -------------------------------------------------------------------
# PORT=8000
# UVICORN_WORKERS=0        # 0 = one per CPU core, capped at 8
# LOG_LEVEL=INFO

# --- Legacy upstream addon (off by default) -----------------------------------
# Mounts the upstream configure page and /config/{blob}/ routes. Anyone who can reach the
# server can then generate an addon URL that spends the keys above, so enable it only on a
# trusted network. The page never displays the keys.
# ENABLE_LEGACY=false
# ENCRYPTION_KEY=          # required when ENABLE_LEGACY=true
# RPDB_API_KEY=            # not used as a form default: RPDB poster URLs expose the key
# PREFERRED_USER_SEARCH_LANGUAGE=en-US
# ENABLE_FEED_CATALOGS=true
# SPLIT_MANIFESTS=false
# MAX_CATALOG_RESULTS=10
# MAX_CATALOG_ENTRIES=100
# CACHE_SEARCH_QUERY_TTL=14400
# FOOTER_ENABLED=true
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
